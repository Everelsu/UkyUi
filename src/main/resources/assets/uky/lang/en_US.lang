# Vanilla splits its hardcore blurb across two keys written to wrap inside a narrow
# button, so either half reads as a dangling fragment on its own. Ours is written to
# be read whole.
uky.gamemode.hardcore.line1=One life, and no difficulty setting.
uky.gamemode.hardcore.line2=When you die, the world dies with you.
uky.gamemode.hardcore.warning=One life. You die for good.


uky.progress.search=Search...
# The three filters beside that box. Short on purpose: they sit in a row of chips
# with the search field, and a long word there costs the search box its width.
uky.progress.filter.all=All
uky.progress.filter.done=Earned
uky.progress.filter.left=Left
# Shown instead of the description while an achievement is still gated behind
# another one — which is the only thing vanilla's tree of arrows actually said.
uky.progress.requires=Needs

# ---- quest notices ----
# Only ever seen when BetterQuesting's own wording could not be reached: the notice
# names itself with a lang key, and a key on screen is not a sentence. Keyed on the
# last part of that key, so a version that renames the notice still lands here.
uky.quest.notice.complete=QUEST COMPLETE
uky.quest.notice.unlock=QUEST UNLOCKED
uky.quest.notice.update=QUEST UPDATED

